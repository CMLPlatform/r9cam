{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":approveMajorUpdates",
    ":enablePreCommit",
    ":preserveSemverRanges"
  ],
  "description": "Branches open on Mondays, all day. A before-4am window can be missed for weeks, and the weekly lock refresh is how patched transitive versions arrive.",
  "timezone": "Europe/Amsterdam",
  "schedule": [
    "* * * * 1"
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "automerge": false,
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": false,
    "labels": [
      "manual-review",
      "security-sensitive"
    ],
    "schedule": [
      "* * * * 1"
    ]
  },
  "ignorePaths": [
    ".python-version"
  ],
  "packageRules": [
    {
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "labels": [
        "github-actions",
        "manual-review",
        "security-sensitive"
      ]
    },
    {
      "description": "picamera2 in Debian Trixie is a CPython 3.13 build; the runtime image and requires-python have to match it",
      "matchPackageNames": [
        "python"
      ],
      "allowedVersions": "<3.14"
    },
    {
      "groupName": "docker",
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "labels": [
        "docker",
        "manual-review",
        "security-sensitive"
      ]
    }
  ],
  "labels": [
    "dependencies",
    "renovate"
  ]
}
